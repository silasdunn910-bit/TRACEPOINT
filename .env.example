# TRACEPOINT API configuration template.
#
# Copy this file to `.env` (project root) or `config/.env` and fill in only the services you use.
# `.env` is git-ignored. NEVER put real keys in this example file or in source code.
# Alternatively set keys from the app (menu 18 -> "k N" or menu 13), which stores them encrypted.
# An encrypted value saved in the app takes precedence over the environment variable.
# Every variable is optional: a provider with no credentials simply shows NOT CONFIGURED.

# --- Search -------------------------------------------------------------------------------
# Your own SearXNG instance base URL (JSON format must be enabled), e.g. http://127.0.0.1:8888
SEARXNG_URL=
BRAVE_SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
# Public engine ID (not a secret). On its own it only powers an embedded search box;
# the JSON API used by TRACEPOINT also needs GOOGLE_SEARCH_API_KEY.
GOOGLE_SEARCH_CX=b20aada3b04a34865

# --- IP / network -------------------------------------------------------------------------
IPINFO_TOKEN=
IPDATA_API_KEY=
IPDB_API_KEY=
OPENIPAPI_API_KEY=

# --- Cybersecurity ------------------------------------------------------------------------
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
# Optional: raises urlscan.io limits (search works without it)
URLSCAN_API_KEY=
# One abuse.ch Auth-Key covers both ThreatFox and URLhaus
ABUSECH_AUTH_KEY=

# --- Government / public records ----------------------------------------------------------
COURTLISTENER_API_KEY=
# One api.data.gov key works for GovInfo and FEC
GOVINFO_API_KEY=
# Optional: without it TRACEPOINT uses the shared DEMO_KEY (very low limits)
FEC_API_KEY=
# SEC EDGAR needs no key but requires a declared contact, e.g. "Jane Doe jane@example.org"
SEC_EDGAR_CONTACT=
OPENCORPORATES_API_KEY=

# --- Other existing integrations ----------------------------------------------------------
HIBP_API_KEY=
OLLAMA_URL=
